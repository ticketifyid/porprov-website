APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Jakarta

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

ADMIN_USERNAME=
ADMIN_PASSWORD=

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=porprov_website
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Wajib true di produksi (domain sudah HTTPS). Biarkan false di lokal supaya
# login lewat http://localhost tetap bisa. Lihat docs/deploy.md.
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# Implementasi pengiriman e-ticket. Lihat docs/notifikasi.md.
#   log  = hanya menulis ke storage/logs, tidak mengirim apa pun (lokal)
#   mail = email asli lewat MAIL_* di bawah; WhatsApp masih log (produksi)
TICKET_NOTIFIER=log

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Produksi: MAIL_MAILER=smtp. MAIL_SCHEME (bukan MAIL_ENCRYPTION di versi
# Laravel ini): smtps untuk port 465 (TLS langsung), smtp untuk port 587
# (STARTTLS otomatis). null = ditebak dari port (465 -> smtps, lainnya smtp).
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
# Batas waktu koneksi SMTP (detik) supaya worker queue tidak macet.
MAIL_TIMEOUT=10
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Cloudflare Turnstile (form pendaftaran publik)
# Aktif secara bawaan. Untuk pengembangan lokal tanpa kunci Turnstile, ubah
# ke false di .env lokal Anda (JANGAN di produksi). Kalau true, isi kedua
# kunci di bawah; form pendaftaran menolak submit tanpa token Turnstile valid.
TURNSTILE_ENABLED=true
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
